//
// Color format converter (UYVY/UYVA -> sRGB/Linear RGBA)
//

#pragma kernel DecodeUYVY_sRGB
#pragma kernel DecodeUYVY_Linear
#pragma kernel DecodeUYVA_sRGB
#pragma kernel DecodeUYVA_Linear

StructuredBuffer<uint> Source;
RWTexture2D<float4> Destination;

// Source frame geometry
//
// The source buffer is addressed as an array of uints, so the strides are
// given by the host instead of being derived from the destination size: NDI
// senders are free to pad the lines, and the frame width isn't necessarily a
// multiple of the thread group size.
//
uint FrameWidth;   // Destination width (pixels)
uint FrameHeight;  // Destination height (pixels)
uint LineStride;   // UYVY plane line stride (uint elements)
uint AlphaOffset;  // Alpha plane origin (bytes)
uint AlphaStride;  // Alpha plane line stride (bytes)

// sRGB to linear conversion
float4 sRGB_to_Linear(float4 c)
{
    float3 lo = c.rgb / 12.92;
    float3 hi = pow((abs(c.rgb) + 0.055) / 1.055, 2.4);
    return float4(c.rgb <= 0.04045 ? lo : hi, c.a);
}

// YUV to RGB conversion (based on Rec.709 constants)
float3 YUV2RGB(float3 yuv)
{
    const float K_B = 0.0722;
    const float K_R = 0.2126;
    const float K_G = 1 - K_B - K_R;

    float y = yuv.x;
    float u = yuv.y;
    float v = yuv.z;

    float r = y + v * (1 - K_R);
    float b = y + u * (1 - K_B);
    float g = (y - K_R * r - K_B * b) / K_G;

    return float3(r, g, b);
}

// Packed UYVY conversion
float4 UnpackUYVY(uint v)
{
    float4 f = uint4(v, v >> 8, v >> 16, v >> 24) & 0xff;
    f.yw = (f.yw -  16) / 219; //  Y components (limited range)
    f.xz = (f.xz - 128) / 112; // UV components (limited range)
    return f;
}

// Single byte fetch from the source buffer
//
// The alpha plane is only byte-aligned (its stride is half the UYVY one), so
// it can't be addressed at the uint granularity.
//
float LoadByte(uint offs)
{
    return ((Source[offs >> 2] >> ((offs & 3) * 8)) & 0xff) / 255.0;
}

// UYVY decoder function (returns a horizontal pixel pair)
float2x4 DecodeUYVY(uint2 id)
{
    uint sy = FrameHeight - 1 - id.y;
    float4 uyvy = UnpackUYVY(Source[sy * LineStride + id.x]);

    return float2x4(float4(YUV2RGB(uyvy.yxz), 1),
                    float4(YUV2RGB(uyvy.wxz), 1));
}

// UYVA decoder function (returns a horizontal pixel pair)
float2x4 DecodeUYVA(uint2 id)
{
    uint sy = FrameHeight - 1 - id.y;
    float4 uyvy = UnpackUYVY(Source[sy * LineStride + id.x]);

    uint ap = AlphaOffset + sy * AlphaStride + id.x * 2;

    return float2x4(float4(YUV2RGB(uyvy.yxz), LoadByte(ap + 0)),
                    float4(YUV2RGB(uyvy.wxz), LoadByte(ap + 1)));
}

// Pixel pair store
//
// The second pixel is guarded for the odd-width case, where the last pair only
// carries a single visible pixel.
//
void StorePair(uint2 id, float4 c0, float4 c1)
{
    uint2 dp = uint2(id.x * 2, id.y);
    Destination[dp] = c0;
    if (dp.x + 1 < FrameWidth) Destination[dp + uint2(1, 0)] = c1;
}

// Out-of-frame thread test
//
// The dispatch size is rounded up, so the trailing groups may run past the
// frame edges.
//
bool IsOutOfFrame(uint2 id)
{
    return id.x * 2 >= FrameWidth || id.y >= FrameHeight;
}

// Decoder kernel entry points

[numthreads(8, 8, 1)]
void DecodeUYVY_sRGB(uint2 id : SV_DispatchThreadID)
{
    if (IsOutOfFrame(id)) return;
    float2x4 d = DecodeUYVY(id);
    StorePair(id, d[0], d[1]);
}

[numthreads(8, 8, 1)]
void DecodeUYVY_Linear(uint2 id : SV_DispatchThreadID)
{
    if (IsOutOfFrame(id)) return;
    float2x4 d = DecodeUYVY(id);
    StorePair(id, sRGB_to_Linear(d[0]), sRGB_to_Linear(d[1]));
}

[numthreads(8, 8, 1)]
void DecodeUYVA_sRGB(uint2 id : SV_DispatchThreadID)
{
    if (IsOutOfFrame(id)) return;
    float2x4 d = DecodeUYVA(id);
    StorePair(id, d[0], d[1]);
}

[numthreads(8, 8, 1)]
void DecodeUYVA_Linear(uint2 id : SV_DispatchThreadID)
{
    if (IsOutOfFrame(id)) return;
    float2x4 d = DecodeUYVA(id);
    StorePair(id, sRGB_to_Linear(d[0]), sRGB_to_Linear(d[1]));
}
