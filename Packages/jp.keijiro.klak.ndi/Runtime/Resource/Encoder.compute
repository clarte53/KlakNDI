//
// Color format converter (sRGB/Linear RGBA -> UYVY/UYVA)
//

#pragma kernel EncodeUYVY_sRGB
#pragma kernel EncodeUYVY_Linear
#pragma kernel EncodeAlpha

Texture2D<float4> Source;
RWStructuredBuffer<uint> Destination;
float VFlip;

// Destination frame geometry
//
// The dimensions are given by the host instead of being taken from the source
// texture: the source can be larger than the frame (SRP render targets), and
// the frame size isn't necessarily a multiple of the thread group size.
//
uint FrameWidth;      // Frame width (pixels)
uint FrameHeight;     // Frame height (pixels)
uint LineStride;      // UYVY plane line stride (uint elements)
uint AlphaOffset;     // Alpha plane origin (uint elements)
uint AlphaCount;      // Alpha plane size (uint elements)
uint AlphaGridWidth;  // Thread grid width of the alpha pass

// Linear to sRGB conversion
float4 Linear_to_sRGB(float4 c)
{
    float3 lo = c.rgb * 12.92;
    float3 hi = (pow(abs(c.rgb), 1 / 2.4) * 1.055) - 0.055;
    return float4(c.rgb <= 0.0031308 ? lo : hi, c.a);
}

// RGB to YUV conversion (based on Rec.709 constants)
float3 RGB2YUV(float3 rgb)
{
    const float K_B = 0.0722;
    const float K_R = 0.2126;
    const float K_G = 1 - K_B - K_R;

    float y = dot(float3(K_R, K_G, K_B), rgb);
    float u = (rgb.b - y) / (1 - K_B);
    float v = (rgb.r - y) / (1 - K_R);

    return float3(y, u, v);
}

// Packed UYVY conversion
uint PackUYVY(float4 v)
{
    v.yw = v.yw * 219 + 16;  //  Y components (limited range)
    v.xz = v.xz * 112 + 128; // UV components (limited range)
    uint4 i = (uint4)(v + 0.5);
    return i.x | (i.y << 8) | (i.z << 16) | (i.w << 24);
}

// UYVY encoder function
void EncodeUYVY(uint2 id, float4 s0, float4 s1)
{
    float3 yuv1 = RGB2YUV(s0.xyz);
    float3 yuv2 = RGB2YUV(s1.xyz);

    float u = (yuv1.y + yuv2.y) / 2;
    float v = (yuv1.z + yuv2.z) / 2;
    float4 uyvy = float4(u, yuv1.x, v, yuv2.x);

    uint dy = lerp(id.y, FrameHeight - 1 - id.y, VFlip);
    Destination[dy * LineStride + id.x] = PackUYVY(uyvy);
}

// Source pixel pair fetch
//
// The second pixel is clamped for the odd-width case, where the last pair only
// carries a single visible pixel.
//
void LoadPair(uint2 id, out float4 s0, out float4 s1)
{
    uint x = id.x * 2;
    s0 = Source[uint2(x, id.y)];
    s1 = Source[uint2(min(x + 1, FrameWidth - 1), id.y)];
}

// Out-of-frame thread test
//
// The dispatch size is rounded up, so the trailing groups may run past the
// frame edges.
//
bool IsOutOfFrame(uint2 id)
{
    return id.x * 2 >= FrameWidth || id.y >= FrameHeight;
}

// Encoder kernel entry points

[numthreads(8, 8, 1)]
void EncodeUYVY_sRGB(uint2 id : SV_DispatchThreadID)
{
    if (IsOutOfFrame(id)) return;
    float4 s0, s1;
    LoadPair(id, s0, s1);
    EncodeUYVY(id, s0, s1);
}

[numthreads(8, 8, 1)]
void EncodeUYVY_Linear(uint2 id : SV_DispatchThreadID)
{
    if (IsOutOfFrame(id)) return;
    float4 s0, s1;
    LoadPair(id, s0, s1);
    EncodeUYVY(id, Linear_to_sRGB(s0), Linear_to_sRGB(s1));
}

// Alpha plane encoder kernel
//
// The alpha plane is tightly packed at one byte per pixel, so its lines are
// not uint aligned unless the width is a multiple of 4. It's addressed as a
// flat array instead: a thread owns exactly one uint, i.e. four consecutive
// pixels, which keeps the writes race free whatever the frame width is. The
// thread grid is folded in 2D to stay within the per-dimension dispatch limit.
//
// Alpha carries no transfer function, so a single kernel covers both the gamma
// and the linear cases.
//
[numthreads(8, 8, 1)]
void EncodeAlpha(uint2 id : SV_DispatchThreadID)
{
    uint dp = id.y * AlphaGridWidth + id.x;
    if (dp >= AlphaCount) return;

    uint total = FrameWidth * FrameHeight;
    uint packed = 0;

    for (uint i = 0; i < 4; i++)
    {
        uint p = dp * 4 + i;
        if (p >= total) break;

        uint y = p / FrameWidth;
        uint x = p - y * FrameWidth;
        uint sy = lerp(y, FrameHeight - 1 - y, VFlip);

        uint a = (uint)(saturate(Source[uint2(x, sy)].w) * 255 + 0.5);
        packed |= a << (i * 8);
    }

    Destination[AlphaOffset + dp] = packed;
}
